TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_CHAT_IDS=123,456

CURSOR_API_KEY=

# 기본 모델 ID (목록: /models 또는 설정 → 모델)
DEFAULT_MODEL_ID=composer-2.5

# 기본 Agent 모드: ask | plan | agent | smart
DEFAULT_MODE=ask

# true = /agent 가 Plan 승인 없이 즉시 실행
SKIP_PLAN_APPROVAL=false

MAX_CONCURRENT_JOBS=1

# 모델별 기본 params — config/model-params.json 과 병합 (.env 가 우선)
# MODEL_DEFAULT_PARAMS={"composer-2.5":[{"id":"fast","value":"false"}]}

MODEL_PARAMS_LOCK=false
MODEL_PARAMS_RESET_ON_MODEL_CHANGE=true

# 사용량 (/usage, /status 한 줄) — cursor.com 쿠키 WorkosCursorSessionToken
# CURSOR_SESSION_TOKEN=user_01XXXX::eyJhbG...
# CURSOR_USAGE_API_BASE=https://api2.cursor.sh
